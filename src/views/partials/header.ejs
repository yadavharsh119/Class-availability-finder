<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Classroom Availability Finder</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; color: #1a1a2e; }
    h1 { margin-bottom: 0.25rem; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0 2rem; }
    th, td { border: 1px solid #d0d0dd; padding: 0.5rem 0.75rem; text-align: left; }
    th { background: #f0f0f7; }
    .status-available { color: #1a7f37; font-weight: 600; }
    .status-occupied { color: #b3261e; font-weight: 600; }
    .status-maintenance { color: #9a6700; font-weight: 600; }
    form.inline { display: inline; }
    fieldset { border: 1px solid #d0d0dd; padding: 1rem; margin-bottom: 1rem; }
    legend { font-weight: 600; }
    label { display: block; margin: 0.5rem 0 0.25rem; }
    input, select { padding: 0.35rem; border: 1px solid #b0b0c0; border-radius: 4px; }
    button { padding: 0.4rem 0.9rem; border: none; border-radius: 4px; background: #2b4f8b; color: white; cursor: pointer; margin-top: 0.75rem; }
    .notice { background: #e6f4ea; border: 1px solid #a7d7af; padding: 0.6rem 1rem; border-radius: 4px; }
    .errors { background: #fdecea; border: 1px solid #f5c6c2; padding: 0.6rem 1rem; border-radius: 4px; color: #b3261e; }
    footer { margin-top: 2rem; color: #777; font-size: 0.85rem; border-top: 1px solid #e0e0e8; padding-top: 0.75rem; }
    .search-box { margin-bottom: 1rem; }
    .search-box label { display: block; margin-bottom: 0.35rem; font-weight: 600; }
    .search-row { display: flex; gap: 0.5rem; align-items: center; }
    .search-row input { flex: 1; }
    .search-clear { color: #2b4f8b; text-decoration: none; font-size: 0.9rem; }
    .search-clear:hover { text-decoration: underline; }
    .no-results { color: #555; font-style: italic; margin: 1rem 0; }
  </style>
</head>
<body>
<header>
  <h1>Classroom Availability Finder</h1>
  <p>Find free classrooms by building, capacity and time slot.</p>
</header>
